# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/

# Generated by build_runner (drift's DriftDatabase tables/queries codegen): regenerate locally
# with `dart run build_runner build`.
**/*.g.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code per-user settings. A shared .claude/settings.json is tracked; the *.local.json variant
# is by definition machine-local (that is what the name means to the tool).
.claude/settings.local.json

# Git worktrees

# Home for `git worktree add worktrees/<name>` checkouts. Ignored so worktrees can live inside the
# repository without ever showing up as untracked content. The directory's README explains the
# workflow and stays tracked, which also keeps the directory itself present after a fresh clone.
/worktrees/*
!/worktrees/README.md

# Claude Code's built-in worktree feature puts its checkouts here instead of ./worktrees/. Ignored so
# a stray one never shows up as untracked content; worktrees/README.md has the intended location.
.claude/worktrees/

# Contains some files used for debugging
debug/
