;
; Placeholders are replaced by the windows-installer GitHub Action:
;   {{APP_NAME}}, {{APP_PUBLISHER}}, {{APP_EXE_NAME}},
;   {{APP_ID}}, {{OUTPUT_BASE_FILENAME}}

#define MyAppName "{{APP_NAME}}"
#define MyAppPublisher "{{APP_PUBLISHER}}"
#define MyAppExeName "{{APP_EXE_NAME}}"

; Version is passed via /DMyAppVersion=x.x.x on the command line
#ifndef MyAppVersion
  #define MyAppVersion "0.1.0"
#endif

[Setup]
AppId={{{{APP_ID}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
; Shows the application's own icon in "Apps & features", taken from the executable, which the
; Flutter runner builds with windows/runner/resources/app_icon.ico embedded.
UninstallDisplayIcon={app}\{#MyAppExeName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename={{OUTPUT_BASE_FILENAME}}
OutputDir=.
Compression=lzma
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Flutter application bundle - everything from the build output
Source: "Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
