{
    "folders": [
        {
            "path": "."
        },
        {
            "name": "actlibs",
            "path": "actlibs"
        }
    ],
    "settings": {
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        // Keep git worktrees (see worktrees/README.md) out of this window: each one is a complete
        // copy of the repository, so indexing them all multiplies the analyzer's and the file
        // watcher's workload. Open a worktree in its own window instead.
        "files.watcherExclude": {
            "**/worktrees/**": true
        },
        "search.exclude": {
            "worktrees": true
        },
        "dart.analysisExcludedFolders": [
            "worktrees"
        ],
        "dart.lineLength": 100,
        "editor.rulers": [
            100
        ],
        "markdown.extension.print.imgToBase64": true,
        "editor.formatOnSave": true
    },
    "launch": {
        "version": "0.2.0",
        "configurations": []
    },
    "extensions": {
        "recommendations": [
            "davidanson.vscode-markdownlint",
            "dart-code.flutter",
            "dart-code.dart-code",
            "github.vscode-github-actions",
            "github.codespaces",
            "yzhang.markdown-all-in-one",
            "redhat.vscode-yaml"
        ]
    }
}
