  "budgetHelpChainExpensesCommittedCaption": "(a commitment)",
  "@budgetHelpChainExpensesCommittedCaption": {
    "description": "Caption under the Committed step of the expenses chain",
    "context": "Displayed under the Committed step of the budget mode's own help chain, on the expenses chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainExpensesPaidCaption": "(an entry)",
  "@budgetHelpChainExpensesPaidCaption": {
    "description": "Caption under the Paid step of the expenses chain",
    "context": "Displayed under the Paid step of the budget mode's own help chain, on the expenses chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainExpensesSentence": "A quote line becomes a commitment, and the commitment is settled by the entries that name it — in one payment or several.",
  "@budgetHelpChainExpensesSentence": {
    "description": "Sentence under the expenses chain, saying how one step becomes the next",
    "context": "Displayed under the budget mode's own help chain, on the expenses chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainResourcesPromisedCaption": "(a resource or a taking)",
  "@budgetHelpChainResourcesPromisedCaption": {
    "description": "Caption under the Promised step of the resources chain",
    "context": "Displayed under the Promised step of the budget mode's own help chain, on the resources chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainResourcesReceivedCaption": "(an entry naming it)",
  "@budgetHelpChainResourcesReceivedCaption": {
    "description": "Caption under the Received step of the resources chain",
    "context": "Displayed under the Received step of the budget mode's own help chain, on the resources chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainResourcesSentence": "Nothing here is settled by hand — what has arrived is summed from the journal's credits that name the row.",
  "@budgetHelpChainResourcesSentence": {
    "description": "Sentence under the resources chain, saying how one step becomes the next",
    "context": "Displayed under the budget mode's own help chain, on the resources chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainSharingReceivedCaption": "(the takings)",
  "@budgetHelpChainSharingReceivedCaption": {
    "description": "Caption under the Received step of the sharing chain",
    "context": "Displayed under the Received step of the budget mode's own help chain, on the sharing chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainSharingRepaidCaption": "(the reimbursable contributions)",
  "@budgetHelpChainSharingRepaidCaption": {
    "description": "Caption under the Already repaid step of the sharing chain",
    "context": "Displayed under the Already repaid step of the budget mode's own help chain, on the sharing chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainSharingLeftToShareCaption": "(the agreed shares)",
  "@budgetHelpChainSharingLeftToShareCaption": {
    "description": "Caption under the Left to share step of the sharing chain",
    "context": "Displayed under the Left to share step of the budget mode's own help chain, on the sharing chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpChainSharingSentence": "The takings come in, the reimbursable contributions come off the top, and only what is left is divided by the agreed shares.",
  "@budgetHelpChainSharingSentence": {
    "description": "Sentence under the sharing chain, saying how one step becomes the next",
    "context": "Displayed under the budget mode's own help chain, on the sharing chain",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpDashboardBody1": "This page types nothing: every figure on it is read from the other views. It is where the mode opens, and the one screen that answers \"where does the whole thing stand\" without opening anything.",
  "@budgetHelpDashboardBody1": {
    "description": "First paragraph of the budget mode's help panel for the Dashboard chip",
    "context": "Displayed on the budget mode's own Help tab while the Dashboard chip is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpDashboardBody2": "The tiles read the whole project and never the poste filter — the quote, what has come in, what has left the account, what the bank holds. {expenses} is where a single poste is read.",
  "@budgetHelpDashboardBody2": {
    "description": "Second paragraph of the budget mode's help panel for the Dashboard chip",
    "context": "Displayed on the budget mode's own Help tab while the Dashboard chip is on screen",
    "type": "text",
    "placeholders": {
      "expenses": {
        "type": "String"
      }
    }
  },
  "budgetHelpDashboardBody3": "The band under them puts what the film needs against what pays for it, with a share bar between the two, and says in words whether they balance or by how much the plan still falls short.",
  "@budgetHelpDashboardBody3": {
    "description": "Third paragraph of the budget mode's help panel for the Dashboard chip, stating the needs/resources balance band",
    "context": "Displayed on the budget mode's own Help tab while the Dashboard chip is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpDashboardBody4": "An alert is not a notification to clear: it is a fact that stays true until the figures behind it change, so each one offers a way into the data it is about rather than a dismiss. The count on the {dashboard} chip carries them wherever you are in the mode.",
  "@budgetHelpDashboardBody4": {
    "description": "Fourth paragraph of the budget mode's help panel for the Dashboard chip, stating the standing alerts",
    "context": "Displayed on the budget mode's own Help tab while the Dashboard chip is on screen",
    "type": "text",
    "placeholders": {
      "dashboard": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody1": "This is the quote itself, poste by poste — the only page where {quote} is typed. The ten CNC postes are seeded once and become ordinary rows from then on: rename, reorder or delete them freely.",
  "@budgetHelpExpensesBody1": {
    "description": "First paragraph of the budget mode's help panel for the Expenses chip",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "quote": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody2": "{paid} reads the cash book's debits that name this poste; {committed} reads the commitments that do. Neither is typed here.",
  "@budgetHelpExpensesBody2": {
    "description": "Second paragraph of the budget mode's help panel for the Expenses chip",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "paid": {
        "type": "String"
      },
      "committed": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody3": "A movement is recorded through {newAction}, the one button this band now carries on every page. It opens a short wizard: first what you are doing — grouped by the document it belongs to, this page's own answers promoted to the top with the first already picked — then, where the answer needs it, what the movement attaches to, and last its amount and date. The first answer fixes the direction and the one thing the movement settles, so a debit is never picked against a credit, and once the amount is typed the app proposes what it settles for a one-click accept — a sum that already exists is never typed twice.",
  "@budgetHelpExpensesBody3": {
    "description": "Third paragraph of the budget mode's help panel for the Expenses chip, stating how a movement is recorded through the wizard opened by the header's New button",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "newAction": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody4": "The {offQuote} row is spending that names no poste at all — it has no quote to measure against, so only its {paid} figure ever prints.",
  "@budgetHelpExpensesBody4": {
    "description": "Fourth paragraph of the budget mode's help panel for the Expenses chip",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "offQuote": {
        "type": "String"
      },
      "paid": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody5": "The excluding/including-tax switch only changes how a figure is displayed. An amount is stored exactly as it was typed, and is never converted on the way in.",
  "@budgetHelpExpensesBody5": {
    "description": "Fifth paragraph of the budget mode's help panel for the Expenses chip",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpExpensesBody6": "{finalCost} is a column of its own: {paid} plus {committed} plus what is still expected to be spent. That last figure is typed on the poste's own fiche, as {estimateToComplete}, and never in the table — left empty it derives itself, the quote less what is already paid and committed, and {derive} hands a typed one back to that derived reading.",
  "@budgetHelpExpensesBody6": {
    "description": "Sixth paragraph of the budget mode's help panel for the Expenses chip, stating the final-cost column and where the estimate to complete behind it is typed",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "finalCost": {
        "type": "String"
      },
      "paid": {
        "type": "String"
      },
      "committed": {
        "type": "String"
      },
      "estimateToComplete": {
        "type": "String"
      },
      "derive": {
        "type": "String"
      }
    }
  },
  "budgetHelpExpensesBody7": "{variance} is read twice, under one word. The column here answers {paid} plus {committed} against the quote — what has actually moved. The fiche's own, beside {finalCost}, answers {finalCost} against the quote instead — what the poste is now expected to end up costing.",
  "@budgetHelpExpensesBody7": {
    "description": "Seventh paragraph of the budget mode's help panel for the Expenses chip, telling the table's own variance from the fiche's",
    "context": "Displayed on the budget mode's own Help tab while the Expenses chip is on screen",
    "type": "text",
    "placeholders": {
      "variance": {
        "type": "String"
      },
      "paid": {
        "type": "String"
      },
      "committed": {
        "type": "String"
      },
      "finalCost": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowIntro": "Every movement the account has seen is listed here, and only here: debits and credits alike, in the order they happened. {expenses} reads the same cash book poste by poste, but keeps the debits naming a poste alone.",
  "@budgetHelpCashFlowIntro": {
    "description": "Lead paragraph of the budget mode's help panel for the tools drawer's Cash flow page, stating it is the only page listing every movement the account has seen, credits included",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {
      "expenses": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowBody1": "Every row is a movement that actually happened, in the order it happened. A {debit} is money out, a {credit} is money in.",
  "@budgetHelpCashFlowBody1": {
    "description": "Second paragraph of the budget mode's help panel for the tools drawer's Cash flow page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {
      "debit": {
        "type": "String"
      },
      "credit": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowBody2": "Naming a poste is what makes a debit count against the quote — leave it blank and it lands in {offQuote} instead.",
  "@budgetHelpCashFlowBody2": {
    "description": "Third paragraph of the budget mode's help panel for the tools drawer's Cash flow page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {
      "offQuote": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowBody3": "{balance} is always the whole cash book's own balance — the mode's poste filter does not reach this page at all.",
  "@budgetHelpCashFlowBody3": {
    "description": "Fourth paragraph of the budget mode's help panel for the tools drawer's Cash flow page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {
      "balance": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowBody4": "{upcoming} follows the statement and is the other half of the same page: what is committed and still owed, in due-date order across every poste, and, at its foot, what the balance becomes once all of it has fallen due. The statement itself is only read: a row here selects its commitment into the fiche, where its outstanding amount is settled — in one payment or several.",
  "@budgetHelpCashFlowBody4": {
    "description": "Fifth paragraph of the budget mode's help panel for the tools drawer's Cash flow page, stating the upcoming section under the statement",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {
      "upcoming": {
        "type": "String"
      }
    }
  },
  "budgetHelpCashFlowBody5": "The voucher number is minted by the app the moment an entry is created. The voucher file itself — a receipt, an invoice, a bank slip — is a separate thing, referenced by its own path rather than kept inside the project.",
  "@budgetHelpCashFlowBody5": {
    "description": "Sixth paragraph of the budget mode's help panel for the tools drawer's Cash flow page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Cash flow page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpResourcesBody1": "This page states what pays for the film — a subsidy, a cash contribution, a contribution in kind — and what the film itself earns, a taking. Adding a valuation is not the same gesture as adding real money, which is why the page's own Add menu names each of the four rather than offering one blank row.",
  "@budgetHelpResourcesBody1": {
    "description": "First paragraph of the budget mode's help panel for the Resources chip",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpResourcesBody2": "{status} is paperwork only — it never means the money has arrived. What has actually arrived is summed from the cash book's credits naming this resource, which is exactly what {recordReceipt} writes.",
  "@budgetHelpResourcesBody2": {
    "description": "Second paragraph of the budget mode's help panel for the Resources chip",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {
      "status": {
        "type": "String"
      },
      "recordReceipt": {
        "type": "String"
      }
    }
  },
  "budgetHelpResourcesBody3": "Money coming in is recorded exactly as money going out: through {newAction}, the same wizard, the same proposal of what the receipt settles. Only the first answer differs — and opened from this page, the wizard promotes it for you, a receipt against a financing resource or a taking sitting at the top.",
  "@budgetHelpResourcesBody3": {
    "description": "Third paragraph of the budget mode's help panel for the Resources chip, stating that a receipt is recorded exactly as a payment is, through the wizard opened by the header's New button",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {
      "newAction": {
        "type": "String"
      }
    }
  },
  "budgetHelpResourcesBody4": "A contribution in kind is valued, never collected: no cash will ever move for it, so it prints no received figure and offers no receipt to record.",
  "@budgetHelpResourcesBody4": {
    "description": "Fourth paragraph of the budget mode's help panel for the Resources chip",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpResourcesBody5": "{reimbursable} means the money must come back out of the takings before anything is shared — see {sharing}.",
  "@budgetHelpResourcesBody5": {
    "description": "Fifth paragraph of the budget mode's help panel for the Resources chip",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {
      "reimbursable": {
        "type": "String"
      },
      "sharing": {
        "type": "String"
      }
    }
  },
  "budgetHelpResourcesBody6": "The band at the foot of the page answers whether this covers the film: one tone for what is {received}, another for what is only {promised}, and, in words, how much would still be missing if nothing more arrived.",
  "@budgetHelpResourcesBody6": {
    "description": "Sixth paragraph of the budget mode's help panel for the Resources chip, stating the coverage band",
    "context": "Displayed on the budget mode's own Help tab while the Resources chip is on screen",
    "type": "text",
    "placeholders": {
      "received": {
        "type": "String"
      },
      "promised": {
        "type": "String"
      }
    }
  },
  "budgetHelpRegieBody1": "This page reads in two directions at once. The left column is catering, computed off the schedule. The right one is a running account of what the production owes people: a row per person carrying what they have advanced, what has come back to them and what is still owed, opening onto their own defrayals and their reimbursements. A person's own menu reimburses them, never for more than is still owed; a defrayal that names nobody stands on its own, counting against the quote and against no running account.",
  "@budgetHelpRegieBody1": {
    "description": "First paragraph of the budget mode's help panel for the tools drawer's Catering & travel page, stating the catering column is computed and the defrayal column is a running account grouped by person",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Catering & travel page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpRegieBody2": "A meal is counted once per meal block, over the people convoked to that block's own slot — never once per shooting day. The buffet, by contrast, is counted once per head, per shooting day.",
  "@budgetHelpRegieBody2": {
    "description": "Second paragraph of the budget mode's help panel for the tools drawer's Catering & travel page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Catering & travel page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpRegieBody3": "Mileage comes from each traveller's own one-way commute and rate, typed on their sheet in Resources.",
  "@budgetHelpRegieBody3": {
    "description": "Third paragraph of the budget mode's help panel for the tools drawer's Catering & travel page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Catering & travel page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpRegieBody4": "A role not yet cast cannot be told apart from the crew, so it counts on its own until it actually is cast.",
  "@budgetHelpRegieBody4": {
    "description": "Fourth paragraph of the budget mode's help panel for the tools drawer's Catering & travel page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Catering & travel page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpRegieBody5": "Nothing here reaches the quote by itself: the provisioning button writes what this page computes into {expenses}, one line per nature within the poste it targets, and leaves any figure typed by hand exactly as it stands.",
  "@budgetHelpRegieBody5": {
    "description": "Fifth paragraph of the budget mode's help panel for the tools drawer's Catering & travel page, stating what the provisioning button writes and what it never overwrites",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Catering & travel page is on screen",
    "type": "text",
    "placeholders": {
      "expenses": {
        "type": "String"
      }
    }
  },
  "budgetHelpSharingBody1": "The takings themselves are recorded in {resources}. This page reads what they add up to once the reimbursable contributions come off the top.",
  "@budgetHelpSharingBody1": {
    "description": "First paragraph of the budget mode's help panel for the tools drawer's Revenue sharing page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Revenue sharing page is on screen",
    "type": "text",
    "placeholders": {
      "resources": {
        "type": "String"
      }
    }
  },
  "budgetHelpSharingBody2": "What each person put in is listed whether or not it comes back: the second column says how much of it is owed, and the row's own menu records a repayment. The reimbursable contributions are taken off the top in full before anything else is split — whether or not they have actually gone back yet.",
  "@budgetHelpSharingBody2": {
    "description": "Second paragraph of the budget mode's help panel for the tools drawer's Revenue sharing page",
    "context": "Displayed on the budget mode's own Help tab while the tools drawer's Revenue sharing page is on screen",
    "type": "text",
    "placeholders": {}
  },
  "budgetHelpSharingBody3": "A payout — what has actually gone out to somebody — is recorded through {newAction} like every other movement; opened from this page, the wizard promotes paying a share to the top, and a row's own menu opens it too, naming the participant for you.",
